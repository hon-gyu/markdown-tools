---
import { getTree } from "../lib/tree";
import type { TreeNode } from "../lib/tree";
import { site } from "../lib/site-config";
import { getVaultIndex } from "../lib/note-index";
import OysterNav from "../components/OysterNav";
import OysterBreadcrumbs, {
  type OysterBreadcrumb,
} from "../components/OysterBreadcrumbs";
import { previewUrlForPath } from "../lib/preview-data";
// KaTeX styles for math rendered by rehype-katex (see astro.config.mjs).
import "katex/dist/katex.min.css";
import "@astryxdesign/core/reset.css";
import "@astryxdesign/core/astryx.css";
import "@astryxdesign/theme-neutral/theme.css";

interface Props {
  title: string;
  // Whether to render the right column (filled via the `rightbar` slot). Opt-in
  // rather than derived from the slot: `Astro.slots.has` is statically true
  // whenever the slot is referenced, even when the page conditionally omits it.
  rightbar?: boolean;
}
const { title, rightbar = false } = Astro.props;

// "Note · Site" in the tab, but never "Site · Site" on a page that already
// carries the site's own name.
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;

// Build the vault tree once, server-side, and hand it to the nav.
const tree = await getTree();
const index = await getVaultIndex();
const { searchDocs } = index;
const previewRoutes = Object.fromEntries(
  index.notes.map((note) => [note.slug, previewUrlForPath(note.path)]),
);

const norm = (path: string) => path.replace(/\/+$/, "") || "/";
function findTrail(nodes: TreeNode[], pathname: string): TreeNode[] | null {
  for (const node of nodes) {
    if (norm(node.urlPath) === pathname) return [node];
    const childTrail = findTrail(node.children, pathname);
    if (childTrail) return [node, ...childTrail];
  }
  return null;
}

const pathname = norm(Astro.url.pathname);
const trail = findTrail(tree, pathname);
const breadcrumbs: OysterBreadcrumb[] =
  pathname === "/"
    ? []
    : [
        { label: site.title, href: "/" },
        ...(trail
          ? trail.map((node, index) => ({
              label: node.title,
              href: index === trail.length - 1 ? undefined : node.urlPath,
              current: index === trail.length - 1,
            }))
          : [{ label: title, current: true }]),
      ];
---

<!doctype html>
<!-- Put the theme scope on the document itself. The nav and breadcrumbs are
     separate React islands, so an island-local Theme cannot scope the prose or
     the other two columns during server render. -->
<html lang="en" data-astryx-theme="neutral">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {site.favicon && <link rel="icon" href={site.favicon} />}
    {/* Restore a saved column layout before first paint: run as a plain inline
        script (not a bundled module, which defers) so the panes never flash at
        their default widths first. */}
    <script is:inline>
      try {
        const saved = JSON.parse(localStorage.getItem("oyster:layout") || "{}");
        for (const name of ["sidebar", "rightbar"]) {
          if (typeof saved[name] === "number") {
            document.documentElement.style.setProperty(
              `--${name}-w`,
              `${saved[name]}px`,
            );
          }
        }
      } catch {
        // A malformed or blocked localStorage just means default widths.
      }
    </script>
  </head>
  <body>
    <header class="mobile-header">
      <button type="button" data-mobile-open="sidebar" aria-controls="mobile-sidebar" aria-expanded="false">
        Menu
      </button>
      <a href="/" class="mobile-title">{site.title}</a>
      <button type="button" data-mobile-search aria-controls="mobile-sidebar" aria-expanded="false">
        Search
      </button>
      {rightbar && (
        <button type="button" data-mobile-open="rightbar" aria-controls="mobile-rightbar" aria-expanded="false">
          Page
        </button>
      )}
    </header>
    <button class="mobile-backdrop" type="button" data-mobile-close aria-label="Close panel" hidden></button>
    <div class="shell">
      <aside class="sidebar" id="mobile-sidebar" data-mobile-panel="sidebar" tabindex="-1">
        <OysterNav
          client:load
          siteTitle={site.title}
          tree={tree}
          pathname={pathname}
          searchCorpus={searchDocs}
        />
      </aside>
      {/* Drag handles for the two column borders. `separator` with an
          `aria-valuenow` is the ARIA-sanctioned window-splitter pattern, so the
          arrow-key path is not a bolt-on: it is what makes this operable at
          all without a pointer. */}
      <main class="content">
        <article>
          <OysterBreadcrumbs items={breadcrumbs} />
          <slot />
        </article>
      </main>
      {
        rightbar && (
          <div
            class="gutter"
            data-gutter="rightbar"
            role="separator"
            aria-orientation="vertical"
            aria-label="Resize right panel"
            tabindex="0"
          />
        )
      }
      {
        rightbar && (
          <aside class="rightbar" id="mobile-rightbar" data-mobile-panel="rightbar" tabindex="-1">
            <slot name="rightbar" />
          </aside>
        )
      }
    </div>
    <section class="note-stack" data-note-stack aria-label="Stacked notes" hidden></section>

    <aside id="note-preview" class="note-preview" role="tooltip" hidden>
      <p class="note-preview-breadcrumb" data-preview-breadcrumb></p>
      <strong data-preview-title></strong>
      <p data-preview-excerpt></p>
      <a data-preview-open>Open note</a>
    </aside>
    <script
      is:inline
      id="note-preview-routes"
      type="application/json"
      set:html={JSON.stringify(previewRoutes)}
    />

    <script>
      import "../scripts/previews";
    </script>
    <script>
      import "../scripts/mobile-shell";
    </script>
    <button type="button" class="back-to-top" data-back-to-top hidden>Back to top</button>
    <script>
      import "../scripts/content-navigation";
    </script>
    <script>
      import "../scripts/stacked-pages";
    </script>

    <script>
      // Column resizing. Each gutter drives one custom property on :root
      // (--sidebar-w / --rightbar-w); the middle column is whatever is left, so
      // there is only ever one number per gutter to track, drag, and persist.
      const KEY = "oyster:layout";
      // Bounds on each rail's rendered width, in px (see the border-box note in
      // the stylesheet). The middle column also keeps a floor, so neither rail
      // can squeeze the prose to nothing. `initial` matches the CSS default and
      // is what a double-click restores.
      const LIMITS = {
        sidebar: { min: 190, max: 460, initial: 289 },
        rightbar: { min: 230, max: 560, initial: 361 },
      } as const;
      const MIN_CONTENT = 360;

      type Pane = keyof typeof LIMITS;

      const shell = document.querySelector<HTMLElement>(".shell");
      const paneEl = (name: Pane) =>
        document.querySelector<HTMLElement>(`.${name}`);

      function readSaved(): Partial<Record<Pane, number>> {
        try {
          return JSON.parse(localStorage.getItem(KEY) || "{}");
        } catch {
          return {};
        }
      }

      // Measured, not read back off the custom property: the property is unset
      // until the first drag, and the pane's real width is the truth either way.
      const widthOf = (name: Pane) =>
        paneEl(name)?.getBoundingClientRect().width ?? LIMITS[name].initial;

      function clamp(name: Pane, px: number): number {
        const limit = LIMITS[name];
        const other: Pane = name === "sidebar" ? "rightbar" : "sidebar";
        // A hidden rail (narrow viewport) has no width to reserve.
        const otherEl = paneEl(other);
        const taken = otherEl ? otherEl.getBoundingClientRect().width : 0;
        const room =
          (shell?.getBoundingClientRect().width ?? 0) - taken - MIN_CONTENT;
        // `min` wins if the window is too small to honour the max — better a
        // cramped middle than a rail that collapses out of reach.
        return Math.max(limit.min, Math.min(px, Math.min(limit.max, room)));
      }

      function setWidth(name: Pane, px: number) {
        const w = clamp(name, px);
        document.documentElement.style.setProperty(`--${name}-w`, `${w}px`);
        document
          .querySelector(`[data-gutter="${name}"]`)
          ?.setAttribute("aria-valuenow", String(Math.round(w)));
        const saved = readSaved();
        saved[name] = w;
        try {
          localStorage.setItem(KEY, JSON.stringify(saved));
        } catch {
          // Persistence is a nicety; the drag itself still applied.
        }
      }

      const gutters =
        document.querySelectorAll<HTMLElement>(".gutter[data-gutter]");

      for (const gutter of gutters) {
        const name = gutter.dataset.gutter as Pane;
        gutter.setAttribute("aria-valuemin", String(LIMITS[name].min));
        gutter.setAttribute("aria-valuemax", String(LIMITS[name].max));
        gutter.setAttribute("aria-valuenow", String(Math.round(widthOf(name))));

        gutter.addEventListener("pointerdown", (e: PointerEvent) => {
          e.preventDefault(); // don't start a text selection
          // Capture so the drag survives the pointer outrunning the handle or
          // crossing the iframe-less graph canvas in the right rail.
          gutter.setPointerCapture(e.pointerId);
          gutter.dataset.dragging = "";
          document.body.dataset.resizing = "";

          // Track the pointer's *movement* from where it went down, rather than
          // mapping its absolute x onto the width: the handle is wider than the
          // border it straddles, so absolute mapping would snap the border to
          // the cursor on mousedown by however far into the handle you grabbed.
          const startX = e.clientX;
          const startWidth = widthOf(name);

          const move = (ev: PointerEvent) => {
            // The sidebar widens as the pointer moves right; the right rail,
            // anchored to the opposite edge, widens as it moves left.
            const delta =
              name === "sidebar" ? ev.clientX - startX : startX - ev.clientX;
            setWidth(name, startWidth + delta);
          };
          const stop = (ev: PointerEvent) => {
            gutter.releasePointerCapture(ev.pointerId);
            delete gutter.dataset.dragging;
            delete document.body.dataset.resizing;
            gutter.removeEventListener("pointermove", move);
            gutter.removeEventListener("pointerup", stop);
            gutter.removeEventListener("pointercancel", stop);
          };
          gutter.addEventListener("pointermove", move);
          gutter.addEventListener("pointerup", stop);
          gutter.addEventListener("pointercancel", stop);
        });

        gutter.addEventListener("keydown", (e: KeyboardEvent) => {
          if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
          e.preventDefault();
          const step = (e.shiftKey ? 48 : 16) * (e.key === "ArrowLeft" ? -1 : 1);
          // Arrows move the *border*, so for the right rail a leftward press
          // makes it wider.
          setWidth(name, widthOf(name) + (name === "sidebar" ? step : -step));
        });

        // Double-click a border to put it back where it started.
        gutter.addEventListener("dblclick", () =>
          setWidth(name, LIMITS[name].initial),
        );
      }

      // Shrinking the window can invalidate a saved width; re-clamp both.
      addEventListener("resize", () => {
        for (const gutter of gutters) {
          const name = gutter.dataset.gutter as Pane;
          setWidth(name, widthOf(name));
        }
      });
    </script>

    <script>
      // Briefly flash a heading when you jump to it (via the TOC or a deep
      // link), the way Obsidian Publish does — a soft cue for where you landed.
      function flashHash() {
        const id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove("heading-flash"); // allow re-trigger on re-click
        void el.offsetWidth; // force reflow so the animation restarts
        el.classList.add("heading-flash");
        el.addEventListener(
          "animationend",
          () => el.classList.remove("heading-flash"),
          { once: true },
        );
      }
      window.addEventListener("hashchange", flashHash);
      if (location.hash) requestAnimationFrame(flashHash); // deep-link on load
    </script>

    <script>
      // Oymarkit preserves Obsidian's `+` / `-` callout state as an attribute.
      // Turn the generated title into a real disclosure button and keep that
      // attribute as the single source of truth for both state and styling.
      for (const callout of document.querySelectorAll<HTMLElement>(
        ".callout[data-callout-fold]",
      )) {
        const oldTitle = callout.querySelector<HTMLElement>(
          ":scope > .callout-title",
        );
        if (!oldTitle) continue;

        const button = document.createElement("button");
        button.type = "button";
        button.className = oldTitle.className;
        button.append(...oldTitle.childNodes);
        oldTitle.replaceWith(button);

        const sync = () =>
          button.setAttribute(
            "aria-expanded",
            String(callout.dataset.calloutFold !== "closed"),
          );
        const toggle = () => {
          callout.dataset.calloutFold =
            callout.dataset.calloutFold === "closed" ? "open" : "closed";
          sync();
        };

        sync();
        button.addEventListener("click", toggle);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --oyster-canvas: light-dark(#ffffff, #1d1b22);
    /* Reading size for rendered Markdown. Astryx's --font-size-base (0.875rem)
       is a UI scale, small for long-form prose, so the article carries its own
       token; change these two to resize the whole body of a note. */
    --oyster-prose-size: 1rem;
    --oyster-prose-leading: 1.6;
    color-scheme: light dark;
    font-family: system-ui, sans-serif;
    line-height: 1.6;
  }
  html {
    scroll-behavior: smooth;
  }
  /* The jump-to-heading flash: an accent wash that fades out over a couple of
     seconds. The negative margin offsets the padding so layout doesn't shift. */
  @keyframes heading-flash {
    from {
      background-color: color-mix(in oklab, #3b82f6 32%, transparent);
    }
    to {
      background-color: transparent;
    }
  }
  .heading-flash {
    animation: heading-flash 2.5s ease-out;
    border-radius: 0.3rem;
    margin-inline: -0.35rem;
    padding-inline: 0.35rem;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .heading-flash {
      animation-duration: 0.01ms;
    }
  }
  body {
    margin: 0;
    background: var(--oyster-canvas);
    color: var(--color-text-primary);
    font-family: var(--font-family-body);
  }
  .mobile-header,
  .mobile-backdrop { display: none; }
  .shell {
    display: flex;
    min-height: 100vh;
    background: var(--oyster-canvas);
  }
  /* Column widths live as custom properties on :root so the inline script in
     <head> can restore a saved layout before first paint. The middle column
     takes whatever is left.

     Both rails are border-box on purpose: the drag maps a cursor position
     straight onto these properties, so the number has to mean the pane's
     *rendered* width. Under the default content-box it would exclude the
     padding and border, and the dragged edge would trail the cursor by exactly
     that much. The defaults below are the old content-box widths plus that
     chrome (16rem + 2rem + 1px, 20rem + 2.5rem + 1px), so the panes still land
     where they always did. */
  .sidebar {
    box-sizing: border-box;
    width: auto;
    flex-shrink: 0;
    padding: 0;
  }
  .sidebar > astro-island {
    display: block;
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .content {
    flex: 1;
    min-width: 0;
    padding: 2rem 2.5rem;
    background: var(--oyster-canvas);
  }
  /* The reading measure is capped on the article, not the column: the column
     has to be free to absorb the slack, or it would stop growing and leave the
     leftover width stranded *after* the right rail. */
  .content > article {
    max-width: 48rem;
  }
  .rightbar {
    box-sizing: border-box;
    width: var(--rightbar-w, 22.5625rem);
    flex-shrink: 0;
    padding: 2rem 1.25rem;
    border-left: 1px solid color-mix(in oklab, currentColor 12%, transparent);
    background: var(--oyster-canvas);
  }

  /* Astryx's reset intentionally removes browser-default block and list
     spacing. Reintroduce a compact reading rhythm for rendered Markdown. */
  .content > article > :where(h1, h2, h3, h4, h5, h6) {
    margin-block: 1.5rem 0.5rem;
  }
  /* Astryx's type scale ramps h4 and below to or under its UI base size, which
     next to the prose size reads as fine print rather than as a heading. In
     prose the deepest levels stay at reading size and separate themselves by
     weight and colour instead. */
  .content article :is(h4, h5, h6) {
    font-size: var(--oyster-prose-size);
    line-height: var(--oyster-prose-leading);
  }
  .content article h6 {
    color: var(--color-text-secondary);
  }
  .content > article > h1 {
    margin-block-start: 1rem;
  }
  .content article {
    /* Astryx sizes <p> at its UI base but leaves list items, definition lists
       and table cells inheriting the root size, so prose came out in two sizes.
       Set the reading size on the article and let all of them inherit it;
       headings carry their own font-size and are handled above. */
    font-size: var(--oyster-prose-size);
    line-height: var(--oyster-prose-leading);
    /* Shared by the code toolbar and the block itself so the language label
       sits over the code's first column. */
    --code-pad-inline: 1rem;
  }
  /* <p> is the one prose element Astryx gives an explicit font-size and
     line-height, which inheritance alone cannot override. */
  .content article :where(p) {
    font-size: inherit;
    line-height: inherit;
  }
  .content article :where(p, ul, ol, blockquote, pre, dl) {
    margin-block: 0.75rem;
  }
  .content article :where(ul, ol) {
    padding-inline-start: 1.5rem;
  }
  .content article ul {
    list-style: disc;
  }
  .content article ol {
    list-style: decimal;
  }
  .content article ul ul {
    list-style: circle;
  }
  .content article ul ul ul {
    list-style: square;
  }
  .content article li + li {
    margin-block-start: 0.25rem;
  }
  .content article li > :where(ul, ol) {
    margin-block: 0.25rem;
  }

  /* The reset makes anchors inherit plain text styling. Prose links need their
     affordance back, but component-owned links and heading permalinks do not. */
  .content article a:not(
    .heading-anchor,
    .wikilink-unresolved,
    .backlink-title,
    .backlink-mention,
    .astryx-breadcrumbs *
  ) {
    color: light-dark(#1d4ed8, #7db4ff);
    text-decoration-line: underline;
    text-decoration-thickness: 0.075em;
    text-underline-offset: 0.16em;
  }
  .content article a:not(
    .heading-anchor,
    .wikilink-unresolved,
    .backlink-title,
    .backlink-mention,
    .astryx-breadcrumbs *
  ):hover {
    color: light-dark(#1e40af, #a8ccff);
  }

  /* Render the editor's intra-note direction hint beside the link. The label
     is generated at build time from source positions, so it needs no client
     script and does not become part of copied prose. */
  .content article a.link-direction::after {
    content: attr(data-link-direction);
    display: inline-block;
    margin-inline-start: 0.22em;
    color: light-dark(#64748b, #94a3b8);
    font-size: 0.78em;
    font-weight: 500;
    text-decoration: none;
    vertical-align: 0.08em;
  }

  /* Other browser prose affordances removed by the reset. These are scoped to
     article content so Astryx components retain their own surface styles. */
  .content article :not(pre) > code {
    padding: 0.1em 0.3em;
    border: 1px solid color-mix(in oklab, currentColor 10%, transparent);
    border-radius: 0.25rem;
    background: var(--color-background-surface);
    font-size: 0.9em;
  }
  /* A code block is one container: `.code-block` carries the border, radius and
     background, and the toolbar and <pre> inside it are unstyled surfaces. The
     <pre> remains its own element only because it is the scroll container and
     the copy button must stay put while the code scrolls. */
  .content article .code-block {
    margin-block: 0.75rem;
    border: 1px solid color-mix(in oklab, currentColor 12%, transparent);
    border-radius: 0.4rem;
    background: var(--color-background-surface);
    overflow: hidden;
  }
  .content article pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 0.85rem var(--code-pad-inline);
    border: 1px solid color-mix(in oklab, currentColor 12%, transparent);
    border-radius: 0.4rem;
    background: var(--color-background-surface);
  }
  /* Inside the wrapper the <pre> gives up every box of its own. */
  .content article .code-block > pre {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: none;
  }
  /* Shiki parks both palettes on every token as custom properties (see
     astro.config.mjs). Pick one per colour scheme; its own backgrounds go
     unused so the block keeps the site's surface. */
  .content article pre.astro-code,
  .content article pre.astro-code span {
    color: var(--shiki-light);
  }
  @media (prefers-color-scheme: dark) {
    .content article pre.astro-code,
    .content article pre.astro-code span {
      color: var(--shiki-dark);
    }
  }
  /* A strip at the top of the block, not a box on top of it: no border, no
     background, only a hairline rule separating it from the code. The inline
     padding is shared so the language label sits over the code's first column. */
  .code-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem var(--code-pad-inline);
    border-block-end: 1px solid color-mix(in oklab, currentColor 8%, transparent);
    color: var(--color-text-secondary);
    font: 0.75rem ui-monospace, monospace;
  }
  /* An icon button: a hit area big enough to hit, no chrome until hovered. */
  .code-toolbar .code-copy {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.7;
  }
  .code-toolbar .code-copy:hover,
  .code-toolbar .code-copy:focus-visible {
    background: color-mix(in oklab, currentColor 10%, transparent);
    opacity: 1;
  }
  .content article .code-block:has(> .mermaid-source) {
    border-inline-start: 3px solid #8b5cf6;
  }
  .external-embed { margin: 1rem 0; }
  .external-embed iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .external-embed p { margin-block: 0.35rem 0; font-size: 0.85rem; }
  .content article blockquote:not(.callout) {
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--color-border-emphasized);
    color: var(--color-text-secondary);
  }
  .content article hr {
    margin-block: 2rem;
    border-color: var(--color-border);
  }
  .content article dt {
    font-weight: var(--font-weight-semibold);
  }
  .content article dd {
    margin-inline-start: 1.5rem;
  }

  /* Breadcrumbs sit inside the article but are a component, not prose. Undo
     the list rhythm above where it would offset every item after the first. */
  .content article .astryx-breadcrumbs ol {
    padding: 0;
    list-style: none;
  }
  .content article .astryx-breadcrumbs li + li {
    margin-block-start: 0;
  }

  /* The draggable borders. The handle is a hair wider than the 1px border it
     sits on and is pulled half its width into the neighbour, so the hit area is
     comfortable while the border stays visually where it was. */
  .gutter {
    flex: 0 0 auto;
    width: 3px;
    margin-inline: -4px;
    z-index: 1;
    cursor: col-resize;
    background: transparent;
    /* The visible line on hover/drag is a centred inset, not a background, so
       it can highlight without the handle's full width lighting up. */
    background-clip: content-box;
    padding-inline: 4px;
    transition: background-color 0.12s ease-in;
    touch-action: none; /* let the pointer handler own horizontal drags */
  }
  .gutter:hover,
  .gutter:focus-visible,
  .gutter[data-dragging] {
    background-color: #3b82f6;
    outline: none;
  }
  /* Keep the cursor and the highlight steady across the whole drag, even when
     the pointer outruns the handle. */
  body[data-resizing] {
