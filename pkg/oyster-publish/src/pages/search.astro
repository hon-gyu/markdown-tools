---
import Base from "../layouts/Base.astro";
import SearchPage from "../components/SearchPage";
import { getVaultIndex } from "../lib/note-index";

const index = await getVaultIndex();
const tags = [...new Set(index.notes.flatMap((note) => note.tags))]
  .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: "base" }));
---
<Base title="Search">
  <h1>Search</h1>
  <SearchPage client:load docs={index.searchDocs} tags={tags} />
</Base>
