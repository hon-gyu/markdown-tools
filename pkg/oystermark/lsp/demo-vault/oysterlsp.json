{
  "$schema": "https://raw.githubusercontent.com/hon-gyu/oyster/main/pkg/oystermark/lsp/oysterlsp.schema.json",
  "dailyNotes": {
    "format": "YYYY-MM-DD",
    "folder": "journal",
    "linkAction": true
  },
  "hover": { "maxChars": 2000 },
  "inlayHints": { "linkDirection": true },
  "codeLens": { "references": true, "showReferencesCommand": "editor.action.showReferences" },
  "goToDefinition": { "unresolvedFragment": "fallback" },
  "diagnostics": { "unresolvedFragment": "fallback" }
}
